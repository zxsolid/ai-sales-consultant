# Модель: yandex или openai (любой сервис с API как у OpenAI)
LLM_PROVIDER=yandex
# YandexGPT: API-ключ сервисного аккаунта с ролью ai.languageModels.user и id каталога
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt
# Если LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Демо в Telegram: токен от @BotFather и чат менеджера (можно свой id)
TELEGRAM_BOT_TOKEN=
MANAGER_CHAT_ID=
# Через сколько минут тишины сказать менеджеру, что клиент ушёл без заявки
FOLLOWUP_MINUTES=30

# Авито: доступ к API мессенджера (выдаёт Авито в личном кабинете)
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=
# Длинная случайная строка. Адрес вебхука: https://ваш-домен/avito/webhook/<секрет>
AVITO_WEBHOOK_SECRET=
